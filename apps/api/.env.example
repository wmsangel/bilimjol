# Postgres (docker-compose поднимает на порту 5433)
DATABASE_URL="postgresql://izn:izn@localhost:5433/izn_study?schema=public"

# JWT-секреты (в проде — длинные случайные значения из секрет-хранилища)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900"        # секунд (15 мин)
JWT_REFRESH_TTL="2592000"   # секунд (30 дней)

PORT="4000"

# Разрешить dev-checkout (мгновенная самоактивация премиума). ТОЛЬКО для локальной
# разработки. В проде НЕ задавать — иначе любой залогиненный получит премиум даром.
ALLOW_DEV_CHECKOUT="1"

# FreedomPay (ex-PayBox) — приём оплаты КР. Заполнить ключами мерчанта после
# заключения договора. Пока пусто — провайдер неактивен, UI использует
# «написать администратору». Публичный webhook: POST /billing/webhook/freedompay
FREEDOMPAY_MERCHANT_ID=""
FREEDOMPAY_SECRET=""
FREEDOMPAY_TESTING="1"      # 1 — тестовый режим, 0 — боевой
