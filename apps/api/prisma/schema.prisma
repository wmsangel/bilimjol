generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Родитель — держатель аккаунта. Содержит ПДн (хранение в РФ, 152-ФЗ).
model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         String         @default("user") // user | admin
  locale       String         @default("ru")
  country      String? // ISO-код: RU, KG, ...
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  children     ChildProfile[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
}

/// Подписка родителя. Активная подписка = премиум-доступ всем его детям.
model Subscription {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String   @default("monthly")
  status           String   @default("active") // active | canceled | expired
  provider         String // dev | freedompay | paybox
  externalId       String?
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

/// Профиль ребёнка. Минимум ПДн: имя, класс, аватар-помощник.
model ChildProfile {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  avatarHelperId String  @default("fox")
  outfit        Json?
  grade         Int      @default(1)
  createdAt     DateTime @default(now())
  progress      Progress[]
  stats         ChildStats?

  @@index([userId])
}

/// Результат по задаче (монотонный: правильно → остаётся правильным).
model Progress {
  id         String       @id @default(uuid())
  childId    String
  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskId     String
  correct    Boolean
  answeredAt DateTime     @default(now())

  @@unique([childId, taskId])
  @@index([childId])
}

/// Агрегированная статистика ребёнка (серия, дневная цель, разблокировки).
model ChildStats {
  childId         String       @id
  child           ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  streakCount     Int          @default(0)
  lastActiveDate  String?
  dailyDate       String?
  dailySolved     Int          @default(0)
  unlockedHelpers String[]     @default([])
  spentStars      Int          @default(0)
  updatedAt       DateTime     @updatedAt
}

/// Refresh-токен (хранится хэш). Для ротации и отзыва сессий.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  device    String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
