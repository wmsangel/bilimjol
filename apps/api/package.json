{
  "name": "@izn-study/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "make-admin": "node scripts/make-admin.js",
    "dev": "nest start --watch",
